<?xml version="1.0"?>
<package format="3">
  <name>irl_world_state</name>
  <version>0.1.0</version>
  <description>Shared current-state aggregator for robot and perception outputs.</description>
  <maintainer email="irl@example.com">IRL Robotics</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>irl_interfaces</depend>
  <depend>rclpy</depend>
  <depend>vision_msgs</depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
