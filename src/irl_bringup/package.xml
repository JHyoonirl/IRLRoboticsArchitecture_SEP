<?xml version="1.0"?>
<package format="3">
  <name>irl_bringup</name>
  <version>0.1.0</version>
  <description>System-level launch files for the IRL robotics architecture.</description>
  <maintainer email="irl@example.com">IRL Robotics</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>irl_active_perception</exec_depend>
  <exec_depend>irl_object_perception</exec_depend>
  <exec_depend>irl_sensor</exec_depend>
  <exec_depend>irl_sensor_prepro</exec_depend>
  <exec_depend>irl_visualization</exec_depend>
  <exec_depend>irl_robot_estimation</exec_depend>
  <exec_depend>irl_camera_calibration</exec_depend>
  <exec_depend>irl_world_state</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
